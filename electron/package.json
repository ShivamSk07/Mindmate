{
  "name": "clarity",
  "version": "1.0.0",
  "description": "Clarity AI Assistant Desktop",
  "main": "main.js",
  "author": "Indevs",
  "build": {
    "appId": "in.indevs.clarity",
    "productName": "Clarity",
    "electronVersion": "33.2.1",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "logo.png",
      "icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clarity"
    }
  }
}
