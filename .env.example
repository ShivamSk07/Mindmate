# ─────────────────────────────────────────────────────────────
# Vercel Deployment Environment Variables
# ─────────────────────────────────────────────────────────────

# 1. Groq Cloud API Keys (Multi-Key Automatic Failover for openai/gpt-oss-120b)
GROQ_API_KEY=gsk_your_primary_groq_api_key_here
GROQ_API_KEY_BACKUP=gsk_your_backup_groq_api_key_here

# 2. Database (Neon PostgreSQL connection strings)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DIRECT_DATABASE_URL=postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require

# 3. NextAuth / JWT Session Encryption Secret (Generate with: openssl rand -hex 16)
NEXTAUTH_SECRET=92bc8cfcb82a4d33930b808922cb739a

# 4. App Base URL (In production set to your Vercel domain e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# 5. Optional Integrations / OAuth (Set in Vercel or local .env)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
